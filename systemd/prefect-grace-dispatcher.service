[Unit]
Description=Prefect GRACE dispatcher loop
After=network-online.target prefect-worker-astro.service
Wants=network-online.target

[Service]
Type=simple
User=astro
WorkingDirectory=/opt/astro-project
Environment=PREFECT_API_URL=http://127.0.0.1:4200/api
ExecStart=/opt/prefect/venv/bin/python -m prefect_grace.dispatcher --interval-seconds 30
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
