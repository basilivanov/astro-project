ENVIRONMENT=development

POSTGRES_DB=astro
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://astro:astro@db:5432/astro

# LLM Configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Budget Models (P0-LLM-CONFIG-01)
OPENROUTER_MODEL=openai/gpt-4.1-nano
OPENROUTER_MODEL_NATAL=openai/gpt-4.1-nano
OPENROUTER_MODEL_FORECAST=openai/gpt-4.1-nano
OPENROUTER_MODEL_HORARY=openai/gpt-4.1-nano
OPENROUTER_MODEL_SYNASTRY=openai/gpt-4.1-nano
OPENROUTER_MODEL_CHEAP=openai/gpt-4.1-nano
OPENROUTER_FALLBACK_CHAIN=openai/gpt-4o-mini

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=astro-saas
OPENROUTER_SITE_URL=
OPENROUTER_MAX_TOKENS=4000
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_RETRY_ATTEMPTS=1

# Concurrency (P0-LLM-CONCURRENCY-01)
OPENROUTER_THROTTLE_SECONDS=0
LLM_CONCURRENCY=10

# LLM CLI Configuration (for stable generation)
DEFAULT_LLM_MODE=openrouter
LLM_CLI_PROVIDER=gemini
LLM_CLI_MODEL=gemini-2.0-flash-exp:free
LLM_CLI_CONCURRENCY=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
GEONAMES_USERNAME=

# Telegram B2C
TELEGRAM_BOT_TOKEN=
BOT_ADMIN_IDS=
BOT_MEDIA_DIR=/app/data
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru
WHISPER_BEAM_SIZE=5

# Billing (YooKassa)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENTS_MODE=real
